{
    "name": "sesfa-backend",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "API e servidor web do SESFA (Sistema de Acompanhamento Familiar).",
    "engines": {
        "node": ">=22.9.0"
    },
    "scripts": {
        "start": "node --env-file-if-exists=.env src/server.js",
        "dev": "node --watch --env-file-if-exists=.env src/server.js",
        "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
        "seed:demo": "node --env-file-if-exists=.env scripts/migrate.js --seed-demo",
        "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
        "test:unit": "node --test \"tests/unit/*.test.js\"",
        "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\""
    },
    "dependencies": {
        "pg": "^8.16.3"
    }
}
